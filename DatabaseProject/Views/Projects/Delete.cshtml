@model DatabaseProject.Models.Project
@{
    ViewData["Title"] = "Delete Project";
}

<h1><i class="bi bi-trash"></i> Delete Project</h1>

<div class="alert alert-danger">
    <h4><i class="bi bi-exclamation-triangle"></i> Warning!</h4>
    <p>Are you sure you want to delete this project? This action cannot be undone.</p>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Project ID:</dt>
            <dd class="col-sm-9">@Model.ProjectID</dd>

            <dt class="col-sm-3">Project Name:</dt>
            <dd class="col-sm-9">@Model.ProjectName</dd>

            <dt class="col-sm-3">Status:</dt>
            <dd class="col-sm-9">
                @if (Model.ProjectStatus == "Active")
                {
                    <span class="badge bg-success">Active</span>
                }
                else if (Model.ProjectStatus == "Completed")
                {
                    <span class="badge bg-primary">Completed</span>
                }
                else if (Model.ProjectStatus == "On Hold")
                {
                    <span class="badge bg-warning">On Hold</span>
                }
                else if (Model.ProjectStatus == "Cancelled")
                {
                    <span class="badge bg-danger">Cancelled</span>
                }
                else
                {
                    <span class="badge bg-secondary">@(Model.ProjectStatus ?? "N/A")</span>
                }
            </dd>

            <dt class="col-sm-3">Description:</dt>
            <dd class="col-sm-9">@(Model.ProjectDescription ?? "N/A")</dd>

            <dt class="col-sm-3">Budget:</dt>
            <dd class="col-sm-9">
                @if (Model.Budget != null)
                {
                    <span class="text-success fw-bold">@Model.Budget.Value.ToString("C")</span>
                }
                else
                {
                    <span class="text-muted">N/A</span>
                }
            </dd>

            <dt class="col-sm-3">Deadline:</dt>
            <dd class="col-sm-9">
                @if (Model.Deadline != null)
                {
                    @Model.Deadline.Value.ToString("MM/dd/yyyy")
                    @if (Model.Deadline.Value < DateTime.Now && Model.ProjectStatus != "Completed")
                    {
                        <span class="badge bg-danger ms-2">Overdue</span>
                    }
                }
                else
                {
                    <span class="text-muted">N/A</span>
                }
            </dd>

            <dt class="col-sm-3">Finish Date:</dt>
            <dd class="col-sm-9">@(Model.FinishDate?.ToString("MM/dd/yyyy") ?? "N/A")</dd>

            <dt class="col-sm-3">Created Date:</dt>
            <dd class="col-sm-9">@(Model.CreateDate?.ToString("MM/dd/yyyy HH:mm:ss") ?? "N/A")</dd>

            <dt class="col-sm-3">Last Updated:</dt>
            <dd class="col-sm-9">@(Model.UpdateDate?.ToString("MM/dd/yyyy HH:mm:ss") ?? "N/A")</dd>
        </dl>
    </div>
</div>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="ProjectID" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Delete
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-x-circle"></i> Cancel
    </a>
</form>
