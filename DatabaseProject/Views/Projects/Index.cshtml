@model IEnumerable<DatabaseProject.Models.Project>
@{
    ViewData["Title"] = "Projects";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-folder"></i> Projects</h1>
    <div>
        <a asp-controller="Profits" asp-action="Index" class="btn btn-success me-2">
            <i class="bi bi-cash-coin"></i> View All Finances
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Project
        </a>
    </div>
</div>

<!-- Search and Filter Form -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-5">
                <label for="searchTerm" class="form-label">Search</label>
                <input type="text" class="form-control" id="searchTerm" name="searchTerm" 
                       value="@ViewBag.SearchTerm" placeholder="Search by project name or description...">
            </div>
            <div class="col-md-3">
                <label for="filterStatus" class="form-label">Project Status</label>
                <select class="form-select" id="filterStatus" name="filterStatus">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(ViewBag.FilterStatus == "Active")">Active</option>
                    <option value="Pending" selected="@(ViewBag.FilterStatus == "Pending")">Pending</option>
                    <option value="Completed" selected="@(ViewBag.FilterStatus == "Completed")">Completed</option>
                    <option value="On Hold" selected="@(ViewBag.FilterStatus == "On Hold")">On Hold</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
            <div class="col-md-2">
                <label class="form-label">&nbsp;</label>
                <a asp-action="Index" class="btn btn-secondary w-100">
                    <i class="bi bi-x-circle"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Project Name</th>
                    <th>Status</th>
                    <th>Budget</th>
                    <th>Deadline</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in Model)
                {
                    <tr>
                        <td>@project.ProjectID</td>
                        <td>@project.ProjectName</td>
                        <td>
                            @if (project.ProjectStatus == "Active")
                            {
                                <span class="badge bg-success">@project.ProjectStatus</span>
                            }
                            else if (project.ProjectStatus == "Completed")
                            {
                                <span class="badge bg-primary">@project.ProjectStatus</span>
                            }
                            else if (project.ProjectStatus == "Pending")
                            {
                                <span class="badge bg-warning text-dark">@project.ProjectStatus</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@project.ProjectStatus</span>
                            }
                        </td>
                        <td>@(project.Budget?.ToString("C") ?? "N/A")</td>
                        <td>@(project.Deadline?.ToString("MM/dd/yyyy") ?? "N/A")</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@project.ProjectID" class="btn btn-sm btn-info" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@project.ProjectID" class="btn btn-sm btn-warning" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@project.ProjectID" class="btn btn-sm btn-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Showing @Model.Count() project(s)
        | <a asp-controller="Profits" asp-action="Index"><i class="bi bi-cash-coin"></i> View financial overview for all projects</a>
    </div>
}
else
{
    <div class="alert alert-info">
        <h4><i class="bi bi-info-circle"></i> No projects found</h4>
        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
        {
            <p>No results found for "@ViewBag.SearchTerm". Try a different search term.</p>
        }
        else
        {
            <p>Click "Create New Project" to add your first project.</p>
        }
    </div>
}
