@model IEnumerable<DatabaseProject.Models.TaskAssignment>
@{
    ViewData["Title"] = "Task Assignments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-list-check"></i> Task Assignments</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New Task
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search Form -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <label for="searchTerm" class="form-label">Search</label>
                <input type="text" class="form-control" id="searchTerm" name="searchTerm" 
                       value="@ViewBag.SearchTerm" placeholder="Search by description, team, or project...">
            </div>
            <div class="col-md-3">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
            <div class="col-md-3">
                <label class="form-label">&nbsp;</label>
                <a asp-action="Index" class="btn btn-secondary w-100">
                    <i class="bi bi-x-circle"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Description</th>
                    <th>Team</th>
                    <th>Project</th>
                    <th>Assigned</th>
                    <th>Deadline</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model)
                {
                    <tr>
                        <td>@task.AssignmentID</td>
                        <td>
                            @if (string.IsNullOrEmpty(task.TaskDescription))
                            {
                                <em class="text-muted">No description</em>
                            }
                            else if (task.TaskDescription.Length > 50)
                            {
                                @task.TaskDescription.Substring(0, 50)<text>...</text>
                            }
                            else
                            {
                                @task.TaskDescription
                            }
                        </td>
                        <td><span class="badge bg-info">@task.TeamName</span></td>
                        <td><span class="badge bg-primary">@task.ProjectName</span></td>
                        <td>@(task.AssignmentDate?.ToString("MM/dd/yyyy") ?? "N/A")</td>
                        <td>
                            @if (task.Deadline.HasValue)
                            {
                                var daysLeft = (task.Deadline.Value - DateTime.Now).Days;
                                if (daysLeft < 0)
                                {
                                    <span class="badge bg-danger">@task.Deadline?.ToString("MM/dd/yyyy") (Overdue)</span>
                                }
                                else if (daysLeft <= 3)
                                {
                                    <span class="badge bg-warning text-dark">@task.Deadline?.ToString("MM/dd/yyyy") (@daysLeft days)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@task.Deadline?.ToString("MM/dd/yyyy")</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">No deadline</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@task.AssignmentID" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@task.AssignmentID" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@task.AssignmentID" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Showing @Model.Count() task(s)
    </div>
}
else
{
    <div class="alert alert-info">
        <h4><i class="bi bi-info-circle"></i> No task assignments found</h4>
        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
        {
            <p>No results found for "@ViewBag.SearchTerm". Try a different search term.</p>
        }
        else
        {
            <p>Click "Create New Task" to add your first task assignment.</p>
        }
    </div>
}
