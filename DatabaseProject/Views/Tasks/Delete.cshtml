@model DatabaseProject.Models.TaskAssignment
@{
    ViewData["Title"] = "Delete Task Assignment";
}

<h1><i class="bi bi-trash"></i> Delete Task Assignment</h1>

<div class="alert alert-danger">
    <h4><i class="bi bi-exclamation-triangle"></i> Warning!</h4>
    <p>Are you sure you want to delete this task assignment? This action cannot be undone.</p>
</div>

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Task Information</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Assignment ID:</dt>
            <dd class="col-sm-9">@Model.AssignmentID</dd>

            <dt class="col-sm-3">Team:</dt>
            <dd class="col-sm-9"><span class="badge bg-info">@Model.TeamName</span></dd>

            <dt class="col-sm-3">Project:</dt>
            <dd class="col-sm-9"><span class="badge bg-primary">@Model.ProjectName</span></dd>

            <dt class="col-sm-3">Task Description:</dt>
            <dd class="col-sm-9">@(Model.TaskDescription ?? "No description provided")</dd>

            <dt class="col-sm-3">Assignment Date:</dt>
            <dd class="col-sm-9">@(Model.AssignmentDate?.ToString("MM/dd/yyyy HH:mm") ?? "N/A")</dd>

            <dt class="col-sm-3">Deadline:</dt>
            <dd class="col-sm-9">
                @if (Model.Deadline.HasValue)
                {
                    var daysLeft = (Model.Deadline.Value - DateTime.Now).Days;
                    @Model.Deadline?.ToString("MM/dd/yyyy")
                    if (daysLeft < 0)
                    {
                        <span class="badge bg-danger ms-2">Overdue by @Math.Abs(daysLeft) days</span>
                    }
                    else if (daysLeft == 0)
                    {
                        <span class="badge bg-warning text-dark ms-2">Due Today!</span>
                    }
                    else if (daysLeft <= 3)
                    {
                        <span class="badge bg-warning text-dark ms-2">@daysLeft days left</span>
                    }
                    else
                    {
                        <span class="badge bg-success ms-2">@daysLeft days left</span>
                    }
                }
                else
                {
                    <span class="text-muted">No deadline set</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="AssignmentID" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Delete
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-x-circle"></i> Cancel
    </a>
</form>
