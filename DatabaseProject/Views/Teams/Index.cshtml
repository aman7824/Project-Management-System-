@model IEnumerable<DatabaseProject.Models.Team>
@{
    ViewData["Title"] = "Teams";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-diagram-3"></i> Teams</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New Team
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Team Name</th>
                    <th>Manager</th>
                    <th>Created Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var team in Model)
                {
                    <tr>
                        <td>@team.TeamID</td>
                        <td>@team.TeamName</td>
                        <td>
                            @if (team.ManagerID != null)
                            {
                                <span class="badge bg-primary">@team.ManagerName</span>
                            }
                            else
                            {
                                <span class="text-muted">No Manager</span>
                            }
                        </td>
                        <td>@(team.CreateDate?.ToString("MM/dd/yyyy") ?? "N/A")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@team.TeamID" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@team.TeamID" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@team.TeamID" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Showing @Model.Count() team(s)
    </div>
}
else
{
    <div class="alert alert-info">
        <h4><i class="bi bi-info-circle"></i> No teams found</h4>
        <p>Click "Create New Team" to add your first team.</p>
    </div>
}
