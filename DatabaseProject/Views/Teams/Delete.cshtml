
@model DatabaseProject.Models.Team
@{
    ViewData["Title"] = "Delete Team";
}

<h1><i class="bi bi-trash"></i> Delete Team</h1>

<div class="alert alert-danger">
    <h4><i class="bi bi-exclamation-triangle"></i> Warning!</h4>
    <p>Are you sure you want to delete this team? This action cannot be undone.</p>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Team ID:</dt>
            <dd class="col-sm-9">@Model.TeamID</dd>

            <dt class="col-sm-3">Team Name:</dt>
            <dd class="col-sm-9">@Model.TeamName</dd>

            <dt class="col-sm-3">Manager:</dt>
            <dd class="col-sm-9">@(Model.ManagerName ?? "No Manager Assigned")</dd>

            <dt class="col-sm-3">Created Date:</dt>
            <dd class="col-sm-9">@(Model.CreateDate?.ToString("MM/dd/yyyy HH:mm:ss") ?? "N/A")</dd>
        </dl>
    </div>
</div>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="TeamID" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Delete
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-x-circle"></i> Cancel
    </a>
</form>



