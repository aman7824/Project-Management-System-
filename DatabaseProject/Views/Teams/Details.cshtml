@model DatabaseProject.Models.Team
@{
    ViewData["Title"] = "Team Details";
}

<h1><i class="bi bi-diagram-3"></i> Team Details</h1>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Team Information</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Team ID:</dt>
            <dd class="col-sm-9">@Model.TeamID</dd>

            <dt class="col-sm-3">Team Name:</dt>
            <dd class="col-sm-9">@Model.TeamName</dd>

            <dt class="col-sm-3">Manager:</dt>
            <dd class="col-sm-9">
                @if (Model.ManagerID != null)
                {
                    <span class="badge bg-primary">@Model.ManagerName</span>
                }
                else
                {
                    <span class="text-muted">No Manager Assigned</span>
                }
            </dd>

            <dt class="col-sm-3">Created Date:</dt>
            <dd class="col-sm-9">@(Model.CreateDate?.ToString("MM/dd/yyyy HH:mm:ss") ?? "N/A")</dd>

            <dt class="col-sm-3">Last Updated:</dt>
            <dd class="col-sm-9">@(Model.UpdateDate?.ToString("MM/dd/yyyy HH:mm:ss") ?? "N/A")</dd>
        </dl>
    </div>
</div>

<!-- Update Manager Section -->
<div class="card mb-4">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-person-badge"></i> Update Team Manager</h5>
    </div>
    <div class="card-body">
        @{
            IEnumerable<SelectListItem>? employeeList = ViewBag.EmployeeList as IEnumerable<SelectListItem>;
        }
        
        <form method="post" asp-action="UpdateManager" asp-route-id="@Model.TeamID" class="row g-3">
            <div class="col-md-8">
                <label for="managerId" class="form-label">Select New Manager</label>
                <select name="managerId" id="managerId" class="form-select">
                    <option value="">-- No Manager --</option>
                    @if (employeeList != null)
                    {
                        @foreach (SelectListItem item in employeeList)
                        {
                            <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                        }
                    }
                </select>
                <div class="form-text">Select an employee to be the team manager, or choose "No Manager" to remove the current manager.</div>
            </div>
            <div class="col-md-4">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="btn btn-warning w-100">
                    <i class="bi bi-person-badge"></i> Update Manager
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Team Members Section -->
<div class="card mb-4">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-people"></i> Team Members (@(ViewBag.Members?.Count ?? 0))</h5>
    </div>
    <div class="card-body">
        @{
            IEnumerable<Employee>? members = ViewBag.Members as IEnumerable<Employee>;
        }
        @if (members != null && members.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Type</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Employee member in members)
                        {
                            <tr>
                                <td>@member.WorkerID</td>
                                <td>@member.FullName</td>
                                <td>@member.Email</td>
                                <td>
                                    @if (member.EmployeeType == 'F')
                                    {
                                        <span class="badge bg-primary">Full-Time</span>
                                    }
                                    else if (member.EmployeeType == 'H')
                                    {
                                        <span class="badge bg-info">Hourly</span>
                                    }
                                </td>
                                <td>
                                    <form method="post" asp-action="RemoveMember" asp-route-teamId="@Model.TeamID" asp-route-workerId="@member.WorkerID" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Remove this member from the team?')">
                                            <i class="bi bi-person-dash"></i> Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-0">No team members yet. Add members using the form below.</p>
        }
    </div>
</div>

<!-- Add Member Form -->
<div class="card mb-4">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-person-plus"></i> Add Team Member (Using sp_Team_AddMember)</h5>
    </div>
    <div class="card-body">

        @{
            IEnumerable<SelectListItem>? availableEmployees = ViewBag.AvailableEmployees as IEnumerable<SelectListItem>;

        }

        @if (availableEmployees != null && availableEmployees.Any())
        {
            <form method="post" asp-action="AddMember" asp-route-id="@Model.TeamID" class="row g-3">
                <div class="col-md-8">
                    <label for="workerId" class="form-label">Select Employee</label>
                    <select name="workerId" id="workerId" class="form-select">
                        <option value="">-- Choose an employee to add --</option>
                        @foreach (SelectListItem item in availableEmployees)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-person-plus"></i> Add Member
                    </button>
                </div>
            </form>
        }
        else
        {
            <p class="text-muted mb-0">All employees are already members of this team!</p>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.TeamID" class="btn btn-warning">
        <i class="bi bi-pencil"></i> Edit Team
    </a>
    <a asp-action="Delete" asp-route-id="@Model.TeamID" class="btn btn-danger">
        <i class="bi bi-trash"></i> Delete Team
    </a>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>
