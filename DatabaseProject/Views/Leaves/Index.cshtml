@model IEnumerable<DatabaseProject.Models.Leave>
@{
    ViewData["Title"] = "Leave Requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-calendar-x"></i> Leave Requests</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Request Leave
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Employee</th>
                    <th>Leave Type</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Total Days</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var leave in Model)
                {
                    <tr>
                        <td>@leave.LeaveNumber</td>
                        <td><span class="badge bg-primary">@leave.EmployeeName</span></td>
                        <td>
                            @switch (leave.LeaveType)
                            {
                                case "Sick":
                                    <span class="badge bg-warning text-dark">Sick Leave</span>
                                    break;
                                case "Vacation":
                                    <span class="badge bg-success">Vacation</span>
                                    break;
                                case "Personal":
                                    <span class="badge bg-info">Personal</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@leave.LeaveType</span>
                                    break;
                            }
                        </td>
                        <td>@leave.StartDate.ToString("MM/dd/yyyy")</td>
                        <td>@leave.EndDate.ToString("MM/dd/yyyy")</td>
                        <td><strong>@leave.TotalLeaveDay</strong> day(s)</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@leave.LeaveNumber" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@leave.LeaveNumber" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Showing @Model.Count() leave request(s)
    </div>
}
else
{
    <div class="alert alert-info">
        <h4><i class="bi bi-info-circle"></i> No leave requests found</h4>
        <p>Click "Request Leave" to submit a leave request using the sp_HR_RequestLeave stored procedure.</p>
    </div>
}
