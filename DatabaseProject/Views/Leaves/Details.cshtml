
@model DatabaseProject.Models.Leave
@{
    ViewData["Title"] = "Leave Details";
}

<h1><i class="bi bi-calendar-event"></i> Leave Request Details</h1>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">Leave Information</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Leave Number:</dt>
            <dd class="col-sm-9">@Model.LeaveNumber</dd>

            <dt class="col-sm-3">Employee:</dt>
            <dd class="col-sm-9"><strong>@Model.EmployeeName</strong></dd>

            <dt class="col-sm-3">Leave Type:</dt>
            <dd class="col-sm-9"><span class="badge bg-info">@Model.LeaveType</span></dd>

            <dt class="col-sm-3">Start Date:</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("MM/dd/yyyy")</dd>

            <dt class="col-sm-3">End Date:</dt>
            <dd class="col-sm-9">@Model.EndDate.ToString("MM/dd/yyyy")</dd>

            <dt class="col-sm-3">Total Days:</dt>
            <dd class="col-sm-9"><span class="badge bg-success">@Model.TotalLeaveDay days</span></dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Delete" asp-route-id="@Model.LeaveNumber" class="btn btn-danger">
        <i class="bi bi-trash"></i> Delete
    </a>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>
