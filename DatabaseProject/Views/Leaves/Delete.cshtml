
@model DatabaseProject.Models.Leave
@{
    ViewData["Title"] = "Delete Leave";
}

<h1><i class="bi bi-trash"></i> Delete Leave Request</h1>

<div class="alert alert-danger">
    <h4><i class="bi bi-exclamation-triangle"></i> Warning!</h4>
    <p>Are you sure you want to delete this leave request?</p>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Leave Number:</dt>
            <dd class="col-sm-9">@Model.LeaveNumber</dd>

            <dt class="col-sm-3">Employee:</dt>
            <dd class="col-sm-9">@Model.EmployeeName</dd>

            <dt class="col-sm-3">Leave Type:</dt>
            <dd class="col-sm-9">@Model.LeaveType</dd>

            <dt class="col-sm-3">Period:</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("MM/dd/yyyy") - @Model.EndDate.ToString("MM/dd/yyyy")</dd>

            <dt class="col-sm-3">Total Days:</dt>
            <dd class="col-sm-9">@Model.TotalLeaveDay days</dd>
        </dl>
    </div>
</div>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="LeaveNumber" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Delete
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-x-circle"></i> Cancel
    </a>
</form>



