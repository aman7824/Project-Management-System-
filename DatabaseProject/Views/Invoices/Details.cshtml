
@model DatabaseProject.Models.Invoice
@{
    ViewData["Title"] = "Invoice Details";
}

<h1><i class="bi bi-receipt"></i> Invoice Details</h1>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">Invoice Information</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Invoice ID:</dt>
            <dd class="col-sm-9"><strong>#@Model.InvoiceID</strong></dd>

            <dt class="col-sm-3">Employee:</dt>
            <dd class="col-sm-9">@(Model.EmployeeName ?? "N/A")</dd>

            <dt class="col-sm-3">Hours Worked:</dt>
            <dd class="col-sm-9">@(Model.HoursWorked.ToString() ?? "N/A")</dd>

            <dt class="col-sm-3">Total Wage:</dt>
            <dd class="col-sm-9"><h4 class="text-success mb-0">@(Model.EmployeeWage?.ToString("C") ?? "N/A")</h4></dd>

            <dt class="col-sm-3">Create Date:</dt>
            <dd class="col-sm-9">@(Model.CreateDate?.ToString("MM/dd/yyyy HH:mm:ss") ?? "N/A")</dd>
        </dl>

        
    </div>
</div>

<div class="mt-3 d-print-none">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
    <button onclick="window.print()" class="btn btn-primary">
        <i class="bi bi-printer"></i> Print Invoice
    </button>
</div>
