@model IEnumerable<DatabaseProject.Models.Invoice>
@{
    ViewData["Title"] = "Invoices";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-receipt"></i> Invoices</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Generate New Invoice
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Any())
{
    var totalAmount = Model.Sum(i => (i.EmployeeWage ?? 0));
    
    <div class="card mb-3 bg-success text-white">
        <div class="card-body">
            <h5 class="card-title"><i class="bi bi-cash-stack"></i> Total Invoices Amount</h5>
            <h2 class="mb-0">@totalAmount.ToString("C")</h2>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Invoice ID</th>
                    <th>Employee</th>
                    <th>Hours Worked</th>
                    <th>Total Wage</th>
                    <th>Create Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Invoice invoice in Model)
                {
                    <tr>
                        <td><strong>#@invoice.InvoiceID</strong></td>
                        <td><span class="badge bg-primary">@invoice.EmployeeName</span></td>
                        <td>@((invoice.HoursWorked ?? 0).ToString() + " Hours")</td>
                        <td class="text-success"><strong>@invoice.EmployeeWage?.ToString("C")</strong></td>
                        <td>@(invoice.CreateDate?.ToString("MM/dd/yyyy HH:mm") ?? "N/A")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@invoice.InvoiceID" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i> View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Showing @Model.Count() invoice(s) | Total Amount: @totalAmount.ToString("C")
    </div>
}
else
{
    <div class="alert alert-info">
        <h4><i class="bi bi-info-circle"></i> No invoices generated</h4>
        <p>Click "Generate New Invoice" to create an invoice.</p>
    </div>
}
