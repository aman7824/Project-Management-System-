
@model DatabaseProject.Models.Employee
@{
    ViewData["Title"] = "Delete Employee";
}

<h1><i class="bi bi-trash"></i> Delete Employee</h1>

<div class="alert alert-danger">
    <h4><i class="bi bi-exclamation-triangle"></i> Warning!</h4>
    <p>Are you sure you want to delete this employee? This action cannot be undone.</p>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Worker ID:</dt>
            <dd class="col-sm-9">@Model.WorkerID</dd>

            <dt class="col-sm-3">Full Name:</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Username:</dt>
            <dd class="col-sm-9">@Model.Username</dd>

            <dt class="col-sm-3">Email:</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Phone Number:</dt>
            <dd class="col-sm-9">@(Model.PhoneNumber ?? "N/A")</dd>

            <dt class="col-sm-3">Employee Type:</dt>
            <dd class="col-sm-9">
                @if (Model.EmployeeType == 'F')
                {
                    <span class="badge bg-primary">Full-Time</span>
                }
                else if (Model.EmployeeType == 'H')
                {
                    <span class="badge bg-info">Hourly</span>
                }
                else
                {
                    <span class="badge bg-secondary">N/A</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="WorkerID" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Delete
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-x-circle"></i> Cancel
    </a>
</form>



