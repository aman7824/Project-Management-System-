@model DatabaseProject.Models.Comment
@{
    ViewData["Title"] = "Delete Comment";
}

<h1><i class="bi bi-trash"></i> Delete Comment</h1>

<div class="alert alert-danger">
    <h4><i class="bi bi-exclamation-triangle"></i> Warning!</h4>
    <p>Are you sure you want to delete this comment? This action cannot be undone.</p>
</div>

<div class="card">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">@(Model.CommentTitle ?? "No Title")</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Comment ID:</dt>
            <dd class="col-sm-9">@Model.CommentNumber</dd>

            <dt class="col-sm-3">Employee:</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrEmpty(Model.EmployeeName))
                {
                    <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.WorkerID" class="text-decoration-none">
                        <i class="bi bi-person-fill"></i> @Model.EmployeeName
                    </a>
                }
                else
                {
                    <span class="text-muted">Not related to any employee</span>
                }
            </dd>

            <dt class="col-sm-3">Related Task:</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrEmpty(Model.AssignmentDescription))
                {
                    <a asp-controller="Tasks" asp-action="Details" asp-route-id="@Model.AssignmentID" class="text-decoration-none">
                        <i class="bi bi-clipboard-check"></i> @Model.AssignmentDescription
                    </a>
                }
                else
                {
                    <span class="text-muted">Not related to any task</span>
                }
            </dd>

            <dt class="col-sm-3">Comment:</dt>
            <dd class="col-sm-9">
                <div class="border p-3 rounded bg-light">
                    @(Model.CommentText ?? "No comment text provided")
                </div>
            </dd>

            <dt class="col-sm-3">Created Date:</dt>
            <dd class="col-sm-9">@(Model.CreateDate?.ToString("MM/dd/yyyy HH:mm:ss") ?? "N/A")</dd>

            <dt class="col-sm-3">Last Updated:</dt>
            <dd class="col-sm-9">@(Model.UpdateDate?.ToString("MM/dd/yyyy HH:mm:ss") ?? "Never")</dd>
        </dl>
    </div>
</div>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="CommentNumber" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Delete
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-x-circle"></i> Cancel
    </a>
</form>
