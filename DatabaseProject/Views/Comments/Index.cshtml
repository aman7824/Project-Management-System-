@model IEnumerable<DatabaseProject.Models.Comment>
@{
    ViewData["Title"] = "Comments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-chat-left-text"></i> Comments</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Comment
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Employee</th>
                    <th>Assignment</th>
                    <th>Title</th>
                    <th>Comment</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var comment in Model)
                {
                    <tr>
                        <td>@comment.CommentNumber</td>
                        <td><span class="badge bg-primary">@comment.EmployeeName</span></td>
                        <td>
                            @if (comment.AssignmentID.HasValue)
                            {
                                <span class="badge bg-info">@comment.AssignmentDescription</span>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>
                        <td>@comment.CommentTitle</td>
                        <td>
                            @if (!string.IsNullOrEmpty(comment.CommentText) && comment.CommentText.Length > 50)
                            {
                                @comment.CommentText.Substring(0, 50)<text>...</text>
                            }
                            else
                            {
                                @comment.CommentText
                            }
                        </td>
                        <td>@(comment.CreateDate?.ToString("MM/dd/yyyy") ?? "N/A")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@comment.CommentNumber" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@comment.CommentNumber" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@comment.CommentNumber" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Showing @Model.Count() comment(s)
    </div>
}
else
{
    <div class="alert alert-info">
        <h4><i class="bi bi-info-circle"></i> No comments found</h4>
        <p>Click "Add New Comment" to create your first comment.</p>
    </div>
}
